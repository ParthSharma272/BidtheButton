{
  "name": "the-button",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "migrate": "node --experimental-strip-types --no-warnings src/server/cli/migrate.ts",
    "seed": "node --experimental-strip-types --no-warnings src/server/cli/seed.ts",
    "reset": "rm -f data/app.db data/app.db-wal data/app.db-shm && npm run seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "recover": "node --experimental-strip-types --no-warnings src/server/cli/recover.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}